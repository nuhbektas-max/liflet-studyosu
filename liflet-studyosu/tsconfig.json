{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "types": ["vite/client", "node"], "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts", "vite.tek.config.ts"]
}
